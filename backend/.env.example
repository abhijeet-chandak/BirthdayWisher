# Copy to .env and fill in real values. Never commit .env.

# Required
MONGO_URI=mongodb://localhost:27017/birthday-wisher
JWT_SECRET=change-me-to-a-long-random-string

# AI providers (features fail gracefully without them)
GEMINI_API_KEY=
ELEVENLABS_API_KEY=

# Optional
PORT=5000
ALLOWED_ORIGINS=http://localhost:3000
GEMINI_MODEL=gemini-2.5-flash
# NODE_ENV=production disables the devOtp returned in API responses
NODE_ENV=development
